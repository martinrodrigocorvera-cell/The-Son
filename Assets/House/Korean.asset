    characterSequence: " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~\_\u2026\u25A1\u4E0A\u4E0D\u4E45\u4E4B\u4E86\u4E8B\u540E\u548C\u5929\u5976\uD55C\uC6C3\uC73C\uB7EC
      \uC654\uC5B4? \uADF8 \uAE40\uC5D0 \uC0AC\uC9C4\uC774\uB77C\uB3C4 \uCC0D\uC5B4\uBCFC\uB798
      \uB124\uB0B4 \uB79C\uD134 \uC880 \uAEBC\uC918. \uC9C0\uAE08 \uBA55\uC2DC\uCF54
      \uB4DC\uB77C\uB9C8 \uBCFC \uC2DC\uAC04\uC774\uC57C. \uB9C8\uB9AC\uC544\uB791
      \uAC19\uC774 \uB418\uB294\uC9C0 \uC54C\uC544\uC57C \uD55C\uB2E4\uACE0\uB538?\uC774
      \uC8C4\uCC45\uAC10 \uB54C\uBB38\uC5D0 \uCC44\uB110\uB3C4 \uBABB \uBC14\uAFB8\uACA0\uC5B4.
      \uADF8\uB798\uB3C4 \uD754\uB4E4\uC544! \uC5B8\uC81C\uBD80\uD130 \uAC70\uAE30
      \uC788\uC5C8\uC5B4?! \uADF8\uB0E5 \uC560\uB2C8\uBA54\uC774\uC158\uC774\uB77C\uB294
      \uAC78 \uC880 \uBCF4\uB824\uB358 \uAC83\uBFD0\uC774\uC57C. \uC774\uB807\uAC8C
      \uD32C\uC11C\uBE44\uC2A4\uAC00 \uB9CE\uC744 \uC904\uC740 \uBAB0\uB790\uC5B4\uC788\uC796\uC544,
      \uC774 \uC904\uAC70\uB9AC \uC9C4\uC9DC \uBBF8\uCCE4\uC5B4. \uD55C\uBC88 \uBD10\uBD10\uB9AC\uC9C0\uAE08\uCBE4
      \uB538\uC774\uB791 \uC2DC\uAC04\uC744 \uBCF4\uB0B4\uACE0 \uC788\uC744 \uAC70\uB77C\uACE0
      \uC0DD\uAC01\uD558\uACA0\uC9C0\uB9CC, \uB098\uB3C4 \uB098\uB984 \uC6B0\uC120\uC21C\uC704\uAC00
      \uC788\uC5B4\uBA74 \uC548 \uB3FC \uC774 \uB300\uC815\uB9D0? \uC774\uC81C \uAC00\uC871\uC758
      \uBC24\uC744 \uC544\uBB34\uB3C4 \uC874\uC911\uD558\uC9C0 \uC54A\uB294 \uAC70\uC57C\uD654\uC5D0
      \uC544\uC774\uC2A4\uD06C\uB9BC\uC740 \uC5B4\uC6B8\uB9AC\uC9C0 \uC54A\uC544\uCC28\uAC11\uACE0
      \uAC15\uD558\uAC8C \uBCF4\uC77C \uC218 \uC788\uC9C0\uB9CC, \uD55C \uBC88 \uAC00\uB77C
      \uC694\uB85C\uB098\uB97C \uBC29\uC5D0\uC11C \uC774\uB3D9\uC2DC\uCF1C\uC57C
      \uD55C\uB2E4\uBA74 \uC18C\uC74C\uC744 \uB0B4\uACE0 \uB3C4\uB9DD\uD504\uB77C\uC774\uBC84\uC2DC\uB77C\uB294
      \uAC78 \uB4E4\uC5B4\uBD24\uC5B4, \uC774 \uBCC0\uD0DC\uC57C\uCCD0\uC11C \uB124
